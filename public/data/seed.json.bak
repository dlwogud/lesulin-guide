":17,"cUsed":8,"aspects":[{"a":"맛","p":100,"n":7}],"quotes":{"pos":{"x":"오쁘띠베르 저도 방문했었는데 진짜 특이한 디저트들도 많고, 그때 두가지 정도 주문해서 먹었는데 충격적일 정도로 맛있었어요ㅠㅠㅠㅠㅠ 오래오래 영업하면 좋겠습니다!!!","at":"2023-12-18","like":320},"neg":{"x":"박준우님의 카페 다녀왔어요.\n엄청 달다는 평이 많아서 걱정했는데, 언니들과 커피 셋에 디저트 셋으로 시작해 디저트 하나 추가에 언니가 뱅쇼까지 달렸습니다, 점심에.\n달아요.근데 정말 기분 좋은 단맛!\n다음에 서울 오면 또 와야겠어요.\n새언니는 여기저기 소문 내야겠다하더라고요.\n레몬타르트 완전 제스타일.\n","at":"2024-02-25","like":0}},"negN":0,"waitN":1,"status":"RATED"},{"id":"s264","n":"묵호회집","r":"서울특별시 중구","addr":"서울 중구 세종대로14길 26","cat":"회","lat":37.56275,"lng":126.978069,"cs":["c1"],"vids":[{"id":"n5Zpld_kH0o","t":"[sub] 성시경의 먹을텐데 l 북창동 묵호회집 (with.최자)","at":"2023-10-30","c":"c1","vw":2143249,"dur":"31:09"}],"cTotal":400,"cVisit":15,"cUsed":5,"aspects":[{"a":"맛","p":100,"n":3}],"quotes":{"pos":{"x":"20년째 단골이 친구가 최근 성시경 방송 나간후 거래처랑 방문해서 12만원 코스시켰는데 저 주방장님 들어오시자마자 내뱉은말 ' 오늘은 왜이렇게 싼거 시키셨어요? \n거래처 앞에서 ~~~~~~~~~\n\n개인적으로 매우 불호인 가게입니다","at":"2024-02-14","like":289},"neg":{"x":"내가 가본 중 최악의 횟집. \n앞으로 최자님 맛집은 저는 거를래요^^\n갔는데 당연히 줄설줄 알았는데 텅텅빔. 😊\n왜이렇게 사람이 없지..  했는데 역시 ㅎ\n1.너무구시대적 영업방식\n2.구성도 엉망\n3.맛도그닥\n4.서비스도별로\n5.이모님도별로(팁도드렸으나)","at":"2023-11-16","like":41}},"negN":1,"waitN":1,"status":"RATED"},{"id":"s265","n":"영동장어","r":"서울특별시 강남구","addr":"서울 강남구 언주로148길 8","cat":"장어","lat":37.520317,"lng":127.035339,"cs":["c1"],"vids":[{"id":"B5rp9kCcqmw","t":"[sub] 성시경의 먹을텐데 l 논현동 영동장어","at":"2023-01-09","c":"c1","vw":1206655,"dur":"24:54"}],"cTotal":400,"cVisit":14,"cUsed":11,"aspects":[{"a":"맛","p":90,"n":10}],"quotes":{"pos":{"x":"맞죠 형님 사람이 라면만 먹고 살 수 있나요? 가성비만 따져가면서 먹을거면 3끼 전부 김밥 먹어야죠 ㅋㅋㅋㅋ 이런 음식점은 기분을 먹으러 가는곳이라 나이가 들수록 몇군데 알아놔야 하는 맛집이라 생각합니다.  형님이 소개해주는 깔끔한 음식점들은 부모님이나 손님 모시기에도 좋아서 많은 도움도 되고 ㅎㅎ 장어","at":"2023-01-10","like":169},"neg":{"x":"오늘 갔다옴.\n소스에서 계피향 너무 강했고\n장어도 퍽퍽함.\n1.5만원짜리 야채구이만 먹은 느낌이드네요.","at":"2024-01-02","like":2}},"negN":2,"waitN":1,"status":"RATED"},{"id":"s266","n":"강남진해장","r":"서울특별시 강남구","addr":"서울 강남구 테헤란로5길 11","cat":"찌개,전골","lat":37.499584,"lng":127.029308,"cs":["c1"],"vids":[{"id":