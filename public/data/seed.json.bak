":7}],"quotes":{"pos":{"x":"을지로점이 참 인상적이었던것이 다른맛집 가면 각종 연예인 싸인이 벽에 쫙 붙어있었는데 여기는 김대중 대통령 사진만 달랑 크게 붙어있어서 그게 참 인상깊었었죠. 엄청난 단골이셨다고...ㅎㅎ 사실 나이드신 분들이 보수적인 분들이 많잖아요. 평일 낮에 가면 누가봐도 깔끔한 옷차림의 어르신분들이 김대중 대통령의","at":"2026-10-19","like":17},"neg":null},"negN":0,"waitN":0,"status":"RATED"},{"id":"s293","n":"신이주신선물오리고기","r":"서울특별시 서초구","addr":"서울 서초구 신반포로 334","cat":"오리","lat":37.510524,"lng":127.020314,"cs":["c1"],"vids":[{"id":"xc_D1hAraD4","t":"[sub] 성시경의 먹을텐데 l 논현역 신이 주신 선물 오리고기","at":"2026-09-24","c":"c1","vw":686833,"dur":"31:00"}],"cTotal":400,"cVisit":20,"cUsed":11,"aspects":[{"a":"맛","p":100,"n":9},{"a":"양","p":100,"n":4},{"a":"서비스","p":100,"n":3}],"quotes":{"pos":{"x":"저의 단골집이 나왔네요. 양념오리구이를 먹고 후식으로 볶음밥 해먹으면 진짜 꿀맛이에요. 밥 넉넉히 볶아서 남은 것 포장해오면 가족 식사로도 좋아요. 백숙과 오리 주물럭은 이집 만큼 맛있는 집이 없어요. 파절이도 너무맛있어요. 성시경씨 먹방은 완전 진심이라는 걸 알았네요.","at":"2026-09-24","like":4},"neg":{"x":"안돼.... 여기 생길때부터 단골인데 이제  웨이팅 생기는건가요 ㅋㅋㅋ\n\n오리고기 먹으면 젊어진다는 사장님 말씀 찐입니다 10년 동안 하나도 안늙으셨어요 ㅋㅋㅋㅋㅋㅋ","at":"2026-09-24","like":10}},"negN":0,"waitN":1,"status":"RATED"},{"id":"s294","n":"복향원판점","r":"서울특별시 중구","addr":"서울 중구 서애로1길 6-4","cat":"중국요리","lat":37.560921,"lng":126.998234,"cs":["c1"],"vids":[{"id":"IOz7sdH57PQ","t":"[sub] 성시경의 먹을텐데 l 충무로 복향원판점","at":"2026-09-17","c":"c1","vw":948359,"dur":"18:03"}],"cTotal":383,"cVisit":16,"cUsed":7,"aspects":[{"a":"맛","p":100,"n":6}],"quotes":{"pos":{"x":"동국대 졸업생인데 여기 진짜 맛있습니다. 학생때는 비싸서 특별한 날이거나 교수님이 사주실때만 갔는데ㅎ","at":"2026-09-17","like":108},"neg":{"x":"동국대 졸업생인데 여기 진짜 맛있습니다. 학생때는 비싸서 특별한 날이거나 교수님이 사주실때만 갔는데ㅎ","at":"2026-09-17","like":108}},"negN":1,"waitN":0,"status":"RATED"},{"id":"s295","n":"시미베","r":"서울특별시 중구","addr":"서울 중구 퇴계로 386-1","cat":"일본식주점","lat":37.56496,"lng":127.01442,"cs":["c1"],"vids":[{"id":"BY3BY_7ZYSk","t":"[sub] 성시경의 먹을텐데 l 신당동 시미베","at":"2026-07-16","c":"c1","vw":491160,"dur":"32:49"}],"cTotal":400,"cVisit":9,"cUsed":5,"aspects":[{"a":"맛","p":100,"n":5}],"quotes":{"pos":{"x":"와우 놀랍게도 2달 전에 다녀옴요......여기 맛있어요","at":"2026-07-17","like":18},"neg":null},"negN":0,"